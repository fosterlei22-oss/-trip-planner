# nginx 配置模板：官方 nginx 镜像启动时用 envsubst 把 ${PORT} / ${BACKEND_URL}
# 替换成环境变量（见 Dockerfile 的 ENV 默认值与 docker-compose / Render 注入），
# 渲染到 /etc/nginx/conf.d/default.conf。
# 其余 nginx 变量（$uri、$http_host、$remote_addr...）不是环境变量，不会被替换。
server {
    # Render 要求服务监听 $PORT（默认 10000）；本地 compose 默认 80（Dockerfile ENV）
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA 回退：前端路由落到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API + SSE
    # proxy_pass 不带尾斜杠，URI 原样透传（/api/trip/plan/stream 保持完整路径）
    # Host 用 $http_host（保留端口）：MCP 的 307 重定向靠 Host 头构造 Location，
    # 若用 $host 会丢掉端口，重定向到错误的地址
    location /api/ {
        proxy_pass http://${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # SSE 需要关闭缓冲，否则事件会被 nginx 攒住不实时推送
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # MCP streamable-http（POST JSON-RPC，可能是流式响应，同样关闭缓冲）
    location /mcp {
        proxy_pass http://${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
